.eval-cache/
eval-output/

# ---------- Docker / hạ tầng local ----------
docker-compose.override.yml
.docker-data/
pgdata/

# ---------- Log ----------
logs/
*.log

# ---------- Công cụ AI agent (cấu hình cá nhân) ----------
.claude/settings.local.json
.claude/worktrees/
